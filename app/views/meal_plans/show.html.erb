<h1><%= @meal_plan.title %></h1>
<p>日付: <%= @meal_plan.plan_date %></p>

<h2>料理</h2>
<% if @meal_plan_dishes.any? %>
  <% @meal_plan_dishes.each do |meal_plan_dish| %>
    <h3><%= meal_plan_dish.category.presence || "-" %> / <%= meal_plan_dish.dish.name %></h3>
    <table class="nutrition-table">
      <thead>
        <tr><th>食品</th><th>分量 (g)</th></tr>
      </thead>
      <tbody>
        <% meal_plan_dish.menu_items.each do |menu_item| %>
          <tr>
            <td><%= menu_item.food.food_name %></td>
            <td>
              <%= form_with model: menu_item, url: menu_item_path(menu_item), method: :patch, local: true, html: { class: "inline-amount-form" } do |f| %>
                <%= f.number_field :amount, step: 0.1, min: 0.1 %>
                <%= f.submit "更新" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% else %>
  <p>料理が登録されていません。</p>
<% end %>

<h2>栄養価サマリー</h2>
<table class="nutrition-table">
  <tr><th>エネルギー</th><td><%= @nutrition[:energy_kcal] %> kcal</td></tr>
  <tr><th>たんぱく質</th><td><%= @nutrition[:protein_g] %> g</td></tr>
  <tr><th>脂質</th><td><%= @nutrition[:fat_g] %> g</td></tr>
  <tr><th>炭水化物</th><td><%= @nutrition[:carbohydrate_g] %> g</td></tr>
</table>

<h2>コメント</h2>
<p><%= @meal_plan.comment.presence || "コメントはありません。" %></p>

<p><%= link_to "料理を変更", edit_meal_plan_path(@meal_plan) %></p>
<p><%= link_to "Download MD", download_md_meal_plan_path(@meal_plan) %></p>
<p><%= link_to "帳票印刷（幼児食）", print_hancho_meal_plan_path(@meal_plan) %></p>
<p><%= link_to "新しい献立を作成", new_meal_plan_path %></p>
